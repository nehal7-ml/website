---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
---

<figure class="flex flex-col items-center gap-4">
  <div
    class="rounded-full bg-linear-to-br from-accent-light/70 to-accent-dark/30 p-1"
  >
    <Image
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-[200px] w-[200px] rounded-full object-cover"
      src={avatar}
      width={400}
      height={400}
      alt="Nehal SK"
      format="webp"
      quality={90}
    />
  </div>
  <figcaption class="text-center md:text-left">
    <p class="text-lg font-semibold">Nehal SK</p>
    <p class="text-sm text-slate-400">Software Engineer</p>
  </figcaption>
</figure>
