---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
---

<div
  class="from-accent-light to-accent-dark flex h-52 w-52 flex-col items-center justify-center rounded-full bg-linear-to-r"
>
  <Image
    loading="lazy"
    class="h-48 w-48 rounded-full object-contain"
    src={avatar}
    width="144"
    height={144}
    alt="Avatar"
    format="webp"
    quality={100}
  />
  <h3>Nehal SK</h3>
  <p class="text-sm">Software Engineer</p>
</div>
