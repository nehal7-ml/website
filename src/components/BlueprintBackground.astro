---

---

<div
  id="blueprint-container"
  class="pointer-events-none fixed inset-0 -z-10 max-w-svw overflow-hidden"
>
  <canvas id="blueprint-canvas" class="h-full w-full opacity-30"></canvas>
</div>

<!-- Rising embers. Animates transform/opacity only, so the compositor owns
     it — no layout, no repaint, no JS. Reduced-motion kills it via global.css. -->
<div
  id="ember-layer"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
  aria-hidden="true"
>
  <span class="ember" style="--x: 7%; --size: 4px; --hue: #f59e0b; --dur: 11s; --delay: 0s; --drift: -24px"></span>
  <span class="ember" style="--x: 16%; --size: 3px; --hue: #fb923c; --dur: 14s; --delay: 3.5s; --drift: 18px"></span>
  <span class="ember" style="--x: 27%; --size: 5px; --hue: #ef4444; --dur: 12s; --delay: 7s; --drift: -14px"></span>
  <span class="ember" style="--x: 35%; --size: 3px; --hue: #fde047; --dur: 15s; --delay: 1.5s; --drift: 26px"></span>
  <span class="ember" style="--x: 46%; --size: 4px; --hue: #f59e0b; --dur: 13s; --delay: 9s; --drift: -20px"></span>
  <span class="ember" style="--x: 54%; --size: 3px; --hue: #fb923c; --dur: 16s; --delay: 5s; --drift: 12px"></span>
  <span class="ember" style="--x: 63%; --size: 5px; --hue: #f59e0b; --dur: 12s; --delay: 11s; --drift: -28px"></span>
  <span class="ember" style="--x: 72%; --size: 3px; --hue: #ef4444; --dur: 15s; --delay: 2.5s; --drift: 22px"></span>
  <span class="ember" style="--x: 84%; --size: 4px; --hue: #fb923c; --dur: 14s; --delay: 8s; --drift: -16px"></span>
  <span class="ember" style="--x: 93%; --size: 3px; --hue: #fde047; --dur: 16s; --delay: 6s; --drift: 20px"></span>
</div>
<script>
  type Element = {
    x: number;
    y: number;
    type: number;
    size: number;
    rotation: number;
  };
  class BlueprintBackground {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    width: number = 0;
    height: number = 0;
    mouseX: number = -1000;
    mouseY: number = -1000;
    elements: Element[] = [];
    grid!: HTMLCanvasElement;
    reduced: boolean = window.matchMedia("(prefers-reduced-motion: reduce)")
      .matches;

    constructor() {
      this.canvas = document.getElementById(
        "blueprint-canvas",
      ) as HTMLCanvasElement;
      this.ctx = this.canvas.getContext("2d")!;

      this.resize();
      this.initElements();
      this.bindEvents();
      this.render();
    }

    resize() {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.canvas.width = this.width;
      this.canvas.height = this.height;
      this.buildGrid();
      this.initElements();
    }

    // The dots never move, so they're drawn once into an offscreen canvas
    // instead of ~1000 fillRects on every animation frame.
    buildGrid() {
      this.grid = document.createElement("canvas");
      this.grid.width = this.width;
      this.grid.height = this.height;
      const g = this.grid.getContext("2d")!;
      g.fillStyle = "rgba(255, 255, 255, 0.03)";
      for (let x = 0; x < this.width; x += 50) {
        for (let y = 0; y < this.height; y += 50) {
          g.fillRect(x, y, 1, 1);
        }
      }
    }

    bindEvents() {
      window.addEventListener("resize", () => this.resize());
      window.addEventListener("mousemove", (e) => {
        this.mouseX = e.clientX;
        this.mouseY = e.clientY;
        document.documentElement.style.setProperty(
          "--mouse-x",
          `${e.clientX}px`,
        );
        document.documentElement.style.setProperty(
          "--mouse-y",
          `${e.clientY}px`,
        );
      });
    }

    initElements() {
      this.elements = [];
      const gridSize = 150;
      const rows = Math.ceil(this.height / gridSize);
      const cols = Math.ceil(this.width / gridSize);

      for (let i = 0; i < rows; i++) {
        for (let j = 0; j < cols; j++) {
          if (Math.random() > 0.6) {
            this.elements.push({
              x: j * gridSize + Math.random() * 50,
              y: i * gridSize + Math.random() * 50,
              type: Math.floor(Math.random() * 4), // 0: box, 1: lines, 2: circles, 3: "code"
              size: 40 + Math.random() * 60,
              rotation: Math.random() * Math.PI * 2,
            });
          }
        }
      }
    }

    drawElement(el: Element) {
      const { ctx } = this;
      ctx.save();
      ctx.translate(el.x, el.y);
      ctx.rotate(el.rotation);
      ctx.strokeStyle = "rgba(100, 150, 255, 0.4)";
      ctx.lineWidth = 0.5;

      switch (el.type) {
        case 0: // Box / Component
          ctx.strokeRect(0, 0, el.size, el.size * 0.6);
          ctx.beginPath();
          ctx.moveTo(0, 10);
          ctx.lineTo(el.size, 10);
          ctx.stroke();
          break;
        case 1: // Lines / Flow
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.lineTo(el.size, 0);
          ctx.moveTo(el.size, 0);
          ctx.lineTo(el.size - 5, -5);
          ctx.moveTo(el.size, 0);
          ctx.lineTo(el.size - 5, 5);
          ctx.stroke();
          break;
        case 2: // Circles / DB
          ctx.beginPath();
          ctx.ellipse(el.size / 2, 0, el.size / 2, 10, 0, 0, Math.PI * 2);
          ctx.moveTo(0, 0);
          ctx.lineTo(0, 20);
          ctx.moveTo(el.size, 0);
          ctx.lineTo(el.size, 20);
          ctx.ellipse(el.size / 2, 20, el.size / 2, 10, 0, 0, Math.PI * 2);
          ctx.stroke();
          break;
        case 3: // "Code" lines
          for (let i = 0; i < 3; i++) {
            ctx.beginPath();
            ctx.moveTo(0, i * 10);
            ctx.lineTo(el.size * (0.4 + Math.random() * 0.6), i * 10);
            ctx.stroke();
          }
          break;
      }
      ctx.restore();
    }

    render() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      this.ctx.drawImage(this.grid, 0, 0);

      // Draw architecture elements revealed by mouse
      this.elements.forEach((el) => {
        const dist = Math.hypot(this.mouseX - el.x, this.mouseY - el.y);
        const maxDist = 250;

        if (dist < maxDist) {
          const alpha = 1 - dist / maxDist;
          this.ctx.globalAlpha = alpha;
          this.drawElement(el);
        }
      });

      if (!this.reduced) requestAnimationFrame(() => this.render());
    }
  }

  // Initialize on load
  new BlueprintBackground();
</script>

<style>
  #blueprint-container {
    background: radial-gradient(
      circle at 50% 50%,
      rgba(20, 25, 40, 0.05) 0%,
      transparent 50%
    );
  }

  .ember {
    position: absolute;
    bottom: -6px;
    left: var(--x);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--hue);
    box-shadow: 0 0 8px var(--hue), 0 0 16px rgba(var(--forge-ember), 0.6);
    opacity: 0;
    animation: ember-rise var(--dur) linear var(--delay) infinite;
  }

  @keyframes ember-rise {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    65% {
      opacity: 0.6;
    }
    100% {
      transform: translate3d(var(--drift), -34vh, 0);
      opacity: 0;
    }
  }
</style>
