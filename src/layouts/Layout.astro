---
interface Props {
  title: string;
}
import "../styles/global.css";
import { Font } from "astro:assets";
import BlueprintBackground from "../components/BlueprintBackground.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
const description =
  "Nehal SK — full-stack engineer in Kolkata building e-commerce platforms, browser extensions, and internal tools for clients worldwide.";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-poppins" />
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.software-smith.in/logo.png" />
    <link rel="icon" href="/logo-dark.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <BlueprintBackground />
    <slot />
    <Footer />
  </body>
</html>
